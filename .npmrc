# ── pnpm configuration ──────────────────────────────────────
# Use frozen lockfile in CI to prevent accidental drift
strict-peer-dependencies=false
auto-install-peers=true

# ── npm publish configuration ──────────────────────────────
access=public

# ── pnpm update behaviour ──────────────────────────────────
save-exact=true
resolve-peers-from-workspace-root=true

# ── CI: don't prompt for confirmation ──────────────────────
confirm-modules-purge=false
