# ── pnpm configuration ──────────────────────────────────────
# Use frozen lockfile in CI to prevent accidental drift
strict-peer-dependencies=false
auto-install-peers=true

# ── npm publish configuration ──────────────────────────────
access=public

# ── pnpm update behaviour ──────────────────────────────────
save-exact=true
resolve-peers-from-workspace-root=true

# ── CI: don't prompt for confirmation ──────────────────────
confirm-modules-purge=false

# ── Supply chain security ──────────────────────────────────
# 3-day cooldown before using new dependency versions
# (4320 minutes = 72 hours). Blocks ~94% of malicious packages.
# pnpm 10+ already disables postinstall scripts by default.
minimumReleaseAge=4320
