{
  "name": "{%PACKAGE_NAME%}",
  "private": true,
  "version": "0.1.0",
  "releaseStatus": "wip",
  "description": "{%COMPONENT_DESCRIPTION%}",
  "type": "module",
  "author": "{%REPO_OWNER%}",
  "license": "MIT",
  "homepage": "https://{%REPO_OWNER%}.github.io/{%REPO_NAME%}/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/{%REPO_OWNER%}/{%REPO_NAME%}.git"
  },
  "bugs": {
    "url": "https://github.com/{%REPO_OWNER%}/{%REPO_NAME%}/issues"
  },
  "keywords": [
    "pix-galaxy",
    "{%COMPONENT_NAME%}",
    "web-component",
    "custom-elements",
    "browser"
  ],
  "sideEffects": true,
  "main": "./artifact/index.cjs",
  "module": "./artifact/index.js",
  "types": "./artifact/index.d.ts",
  "exports": {
    ".": {
      "types": "./artifact/index.d.ts",
      "import": "./artifact/index.js",
      "require": "./artifact/index.cjs",
      "default": "./artifact/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "artifact",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "GOVERNANCE.md",
    "SECURITY.md",
    "SUPPORT.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm build:lib && pnpm build:site",
    "build:lib": "node ../pix-core/scripts/build.mjs && pnpm build:types",
    "build:types": "tsc --project ./tsconfig.types.json && node ../pix-core/scripts/finalize-types.mjs",
    "build:site": "pnpm docs:build && vite build --config ./vite.config.mjs",
    "check": "pnpm test && pnpm build",
    "clean": "rm -rf artifact dist coverage .artifacts",
    "dev": "pnpm docs:build && vite --config ./vite.config.mjs",
    "docs:build": "node ../pix-core/scripts/docs.mjs",
    "docs:watch": "node ../pix-core/scripts/docs.mjs --watch",
    "prepack": "pnpm build:lib",
    "prepublishOnly": "pnpm check",
    "preview": "vite preview --config ./vite.config.mjs",
    "release": "node ../../scripts/release.mjs",
    "test": "pnpm docs:build && node --test --import ../pix-core/scripts/register-test-loader.mjs ./src/tests/*.test.js",
    "test:coverage": "pnpm docs:build && c8 --reporter=text --reporter=lcov node --test --import ../pix-core/scripts/register-test-loader.mjs ./src/tests/*.test.js",
    "lint": "eslint src/",
    "release:dry": "node ../../scripts/release.mjs --dry-run"
  },
  "dependencies": {
    "@pix-galaxy/pix-color-scheme-selector": "workspace:*",
    "@pix-galaxy/pix-highlighter": "workspace:*",
    "@pix-galaxy/pix-core": "workspace:*",
    "@pix-galaxy/pix-foundations": "workspace:*"
  },
  "devDependencies": {
    "c8": "11.0.0",
    "concurrently": "10.0.4",
    "esbuild": "0.28.1",
    "jsdom": "30.0.1",
    "marked": "18.0.5",
    "typescript": "6.0.3",
    "vite": "8.2.1"
  }
}
