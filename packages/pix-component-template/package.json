{
  "name": "{%PACKAGE_NAME%}",
  "private": true,
  "version": "0.1.0",
  "description": "{%COMPONENT_DESCRIPTION%}",
  "type": "module",
  "author": "{%REPO_OWNER%}",
  "license": "MIT",
  "homepage": "https://{%REPO_OWNER%}.github.io/{%REPO_NAME%}/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/{%REPO_OWNER%}/{%REPO_NAME%}.git"
  },
  "bugs": {
    "url": "https://github.com/{%REPO_OWNER%}/{%REPO_NAME%}/issues"
  },
  "keywords": [
    "pix-galaxy",
    "{%COMPONENT_NAME%}",
    "web-component",
    "custom-elements",
    "browser"
  ],
  "sideEffects": true,
  "engines": {
    "node": ">=20.11",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.33.2",
  "main": "./artifact/index.cjs",
  "module": "./artifact/index.js",
  "types": "./artifact/index.d.ts",
  "exports": {
    ".": {
      "types": "./artifact/index.d.ts",
      "import": "./artifact/index.js",
      "require": "./artifact/index.cjs",
      "default": "./artifact/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "artifact",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "GOVERNANCE.md",
    "SECURITY.md",
    "SUPPORT.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node ./scripts/run.mjs \"pnpm build:lib && pnpm build:site\"",
    "build:lib": "node ./scripts/run.mjs \"node ./scripts/build.mjs\"",
    "build:types": "node ./scripts/run.mjs \"tsc --project ./tsconfig.types.json && node ./scripts/finalize-types.mjs\"",
    "build:site": "node ./scripts/run.mjs \"pnpm docs:build && vite build --config ./vite.config.mjs\"",
    "check": "pnpm test && pnpm build",
    "clean": "rm -rf artifact dist coverage .artifacts",
    "dev": "node ./scripts/run.mjs \"pnpm docs:build && vite --config ./vite.config.mjs\"",
    "docs:build": "node ./scripts/run.mjs \"node ./scripts/docs.mjs\"",
    "docs:watch": "node ./scripts/run.mjs \"node ./scripts/docs.mjs --watch\"",
    "prepack": "node ./scripts/run.mjs \"pnpm build:lib\"",
    "prepublishOnly": "pnpm check",
    "preview": "vite preview --config ./vite.config.mjs",
    "release": "node ./scripts/run.mjs \"node ./scripts/release.mjs\"",
    "test": "node ./scripts/run.mjs \"pnpm docs:build && node --test --import ./scripts/register-test-loader.mjs ./src/tests/*.test.js\"",
    "test:coverage": "node ./scripts/run.mjs \"pnpm docs:build && c8 --reporter=text --reporter=lcov node --test --import ./scripts/register-test-loader.mjs ./src/tests/*.test.js\"",
    "lint": "eslint src/",
    "typecheck": "tsc --project ./tsconfig.types.json --noEmit"
  },
  "devDependencies": {
    "@pix-galaxy/pix-highlighter": "workspace:*",
    "c8": "11.0.0",
    "concurrently": "9.2.1",
    "esbuild": "0.28.0",
    "jsdom": "29.1.0",
    "marked": "18.0.2",
    "typescript": "6.0.3",
    "vite": "8.0.10"
  }
}
