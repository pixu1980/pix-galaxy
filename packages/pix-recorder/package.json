{
  "name": "@pix-galaxy/pix-recorder",
  "version": "0.1.0",
  "description": "Accessible audio recorder Web Component with waveform visualization for the pix-galaxy suite.",
  "type": "module",
  "author": "Emiliano Pisu",
  "license": "MIT",
  "homepage": "https://pixu1980.github.io/pix-recorder/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pixu1980/pix-galaxy.git",
    "directory": "packages/pix-recorder"
  },
  "keywords": [
    "pix-galaxy",
    "pix-recorder",
    "audio",
    "recorder",
    "waveform",
    "web-component",
    "custom-elements",
    "browser"
  ],
  "sideEffects": true,
  "engines": {
    "node": ">=20.11",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.33.2",
  "main": "./artifact/index.cjs",
  "module": "./artifact/index.js",
  "types": "./artifact/index.d.ts",
  "exports": {
    ".": {
      "types": "./artifact/index.d.ts",
      "import": "./artifact/index.js",
      "require": "./artifact/index.cjs",
      "default": "./artifact/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "artifact",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "GOVERNANCE.md",
    "SECURITY.md",
    "SUPPORT.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "pnpm build:lib && pnpm build:site",
    "build:lib": "node ../pix-core/scripts/build.mjs && pnpm build:types",
    "build:site": "pnpm docs:build && vite build --config ./vite.config.mjs",
    "build:types": "tsc --project ./tsconfig.types.json && node ../pix-core/scripts/finalize-types.mjs",
    "check": "pnpm test && pnpm build",
    "clean": "rm -rf artifact dist coverage .artifacts",
    "dev": "pnpm docs:build && node ../../scripts/dev.mjs --config ./vite.config.mjs --name rec",
    "docs:build": "node ../pix-core/scripts/docs.mjs",
    "docs:watch": "node ../pix-core/scripts/docs.mjs --watch",
    "prepack": "pnpm build:lib",
    "preview": "vite preview --config ./vite.config.mjs",
    "release": "node ./scripts/release.mjs",
    "test": "pnpm docs:build && node --test --import ../pix-core/scripts/register-test-loader.mjs ./src/tests/*.test.js",
    "lint": "eslint src/",
    "typecheck": "tsc --project ./tsconfig.types.json --noEmit"
  },
  "dependencies": {
    "@pix-galaxy/pix-color-scheme-selector": "workspace:*",
    "@pix-galaxy/pix-highlighter": "workspace:*",
    "@pix-galaxy/pix-core": "workspace:*",
    "@pix-galaxy/pix-foundations": "workspace:*"
  },
  "devDependencies": {
    "c8": "11.0.0",
    "concurrently": "10.0.4",
    "esbuild": "0.28.1",
    "jsdom": "30.0.1",
    "marked": "18.0.2",
    "typescript": "6.0.3",
    "vite": "8.2.1"
  }
}
