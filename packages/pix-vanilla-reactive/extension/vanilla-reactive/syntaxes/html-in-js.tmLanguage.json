{
  "scopeName": "inline.pix-html-template",
  "name": "pix HTML inside js",
  "injectionSelector": "L:source.js -comment -string",
  "patterns": [
    {
      "name": "meta.template.pix.html",
      "begin": "html\\s*`",
      "beginCaptures": {
        "0": { "name": "entity.name.function.template.pix" }
      },
      "end": "`",
      "endCaptures": {
        "0": { "name": "entity.name.function.template.pix" }
      },
      "patterns": [
        { "include": "#pix-directives" },
        { "include": "#pix-expressions" },
        { "include": "#pix-events" },
        { "include": "#pix-interpolation" },
        { "include": "#html-content" }
      ]
    }
  ],
  "repository": {
    "pix-directives": {
      "patterns": [
        { "match": "<for\\b", "name": "keyword.control.pix.for" },
        { "match": "</for>", "name": "keyword.control.pix.for" },
        { "match": "<if\\b", "name": "keyword.control.pix.if" },
        { "match": "<elseif\\b", "name": "keyword.control.pix.elseif" },
        { "match": "<else>", "name": "keyword.control.pix.else" },
        { "match": "</if>", "name": "keyword.control.pix.if" },
        { "match": "<switch\\b", "name": "keyword.control.pix.switch" },
        { "match": "</switch>", "name": "keyword.control.pix.switch" },
        { "match": "<case\\b", "name": "keyword.control.pix.case" },
        { "match": "<default>", "name": "keyword.control.pix.default" },
        { "match": "\\beach\\s*=", "name": "keyword.other.pix.each" },
        { "match": "\\bcondition\\s*=", "name": "keyword.other.pix.condition" },
        { "match": "\\bexpr\\s*=", "name": "keyword.other.pix.expr" },
        { "match": "\\bresult\\s*=", "name": "keyword.other.pix.result" }
      ]
    },
    "pix-expressions": {
      "begin": "\\{\\{",
      "end": "\\}\\}",
      "name": "meta.expression.pix",
      "patterns": [
        {
          "match": "\\|\\s*(raw|upper|lower|capitalize|slugify|trim|escapeHtml|striptags|json|default|truncate|length|first|last|join|date|timeAgo|urlencode|sortBy)\\b",
          "name": "support.function.filter.pix"
        },
        { "match": "\\b(true|false|null|undefined)\\b", "name": "constant.language.pix" },
        { "match": "\\d+", "name": "constant.numeric.pix" },
        { "match": "\"[^\"]*\"|'[^']*'", "name": "string.quoted.pix" },
        { "match": "[a-zA-Z_$][\\w$.]*", "name": "variable.other.pix" }
      ]
    },
    "pix-events": {
      "match": "@[a-zA-Z]+(?:-[a-zA-Z]+)*",
      "name": "entity.other.attribute-name.event.pix"
    },
    "pix-interpolation": {
      "begin": "\\$\\{",
      "end": "\\}",
      "name": "meta.interpolation.pix",
      "patterns": [{ "include": "source.js" }]
    },
    "html-content": {
      "patterns": [{ "include": "text.html.derivative" }]
    }
  }
}
