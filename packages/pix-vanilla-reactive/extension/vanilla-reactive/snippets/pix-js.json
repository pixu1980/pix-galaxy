{
  "pix html tagged template": {
    "prefix": "html",
    "body": "html`${1:<!-- template -->}`",
    "description": "pix html tagged template"
  },
  "pix component structure": {
    "prefix": "pix-component",
    "body": [
      "import { vrComponent, html } from '../core/index.js';",
      "",
      "export class ${1:MyComponent} extends HTMLElement {",
      "  static { vrComponent(this, { tag: '${2:my-component}', css: import.meta.url }); }",
      "",
      "  ${3:/* @click handlers */}",
      "",
      "  context() {",
      "    return { ${4:data} };",
      "  }",
      "",
      "  render(ctx) {",
      "    return html`",
      "      <section data-part=\"${5:root}\">",
      "        $0",
      "      </section>",
      "    `;",
      "  }",
      "}"
    ],
    "description": "pix component with vrComponent"
  },
  "pix functional component": {
    "prefix": "pix-fn",
    "body": [
      "import { html } from '../core/index.js';",
      "",
      "/**",
      " * ${1:ComponentName}",
      " * @param {object} ctx",
      " * @returns {TemplateResult}",
      " */",
      "export function ${1:ComponentName}(ctx) {",
      "  return html`",
      "    <section data-part=\"${2:root}\">",
      "      $0",
      "    </section>",
      "  `;",
      "}"
    ],
    "description": "pix functional component"
  },
  "pix effect mount": {
    "prefix": "pix-effect",
    "body": [
      "import { Store, effect, html, render } from '../core/index.js';",
      "",
      "const store = new Store({ ${1:data} });",
      "",
      "effect(() => {",
      "  store.tick.get();",
      "  const ctx = { ${2:data}: store.state.${2:data} };",
      "  render(${3:Component}(ctx), document.getElementById('root'), ctx, { ${4:handlers} });",
      "});"
    ],
    "description": "pix effect mount"
  }
}
