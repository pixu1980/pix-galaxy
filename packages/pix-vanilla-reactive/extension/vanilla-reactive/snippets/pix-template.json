{
  "pix template structure": {
    "prefix": "pix-template",
    "body": [
      "<!-- ═══════════════════════════════════════════════",
      "  ${1:ComponentName} - external template",
      "  ═══════════════════════════════════════════════ -->",
      "<section data-part=\"${2:name}\">",
      "  $0",
      "</section>"
    ],
    "description": "pix external template structure"
  },
  "pix for loop": {
    "prefix": "pix-for",
    "body": ["<for each=\"${1:item} in ${2:items}\">", "  $0", "</for>"],
    "description": "pix <for> loop"
  },
  "pix if block": {
    "prefix": "pix-if",
    "body": ["<if condition=\"${1:expr}\">", "  $0", "</if>"],
    "description": "pix <if> conditional"
  },
  "pix if-else": {
    "prefix": "pix-ifelse",
    "body": ["<if condition=\"${1:expr}\">", "  ${2:when true}", "<else>", "  ${3:when false}", "</if>"],
    "description": "pix <if>/<else>"
  },
  "pix switch": {
    "prefix": "pix-switch",
    "body": [
      "<switch expr=\"${1:value}\">",
      "  <case result=\"${2:case1}\">${3:body}</case>",
      "  <default>${4:fallback}</default>",
      "</switch>"
    ],
    "description": "pix <switch>/<case>"
  },
  "pix data-part attribute": {
    "prefix": "data-part",
    "body": "data-part=\"${1:role}\"",
    "description": "pix data-part attribute"
  },
  "pix click event": {
    "prefix": "pix-click",
    "body": "@click=\"${1:handler}($2)\"",
    "description": "pix @click event binding"
  },
  "pix expression": {
    "prefix": "pix-expr",
    "body": "{{ ${1:expr} }}",
    "description": "pix {{ }} expression"
  },
  "pix expression with filter": {
    "prefix": "pix-filter",
    "body": "{{ ${1:expr} | ${2:upper} }}",
    "description": "pix {{ }} with filter"
  }
}
