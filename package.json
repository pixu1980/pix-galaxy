{
  "name": "pix-galaxy",
  "private": true,
  "version": "0.1.0",
  "description": "Monorepo for the PixGalaxy ecosystem of zero-runtime-dependency vanilla JS Web Components",
  "type": "module",
  "author": "Emiliano Pisu",
  "license": "MIT",
  "homepage": "https://pixu1980.github.io/pix-galaxy/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pixu1980/pix-galaxy.git"
  },
  "bugs": {
    "url": "https://github.com/pixu1980/pix-galaxy/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/pixu1980"
  },
  "scripts": {
    "build": "pnpm build:portal && pnpm -r --if-present run build",
    "build:lib": "pnpm -r --if-present run build:lib",
    "build:portal": "vite build --config ./vite.config.mjs",
    "build:site": "pnpm build:portal && pnpm -r --if-present run build:site",
    "build:types": "pnpm -r --if-present run build:types",
    "clean": "pnpm -r --if-present run clean",
    "dev": "node scripts/dev.mjs --config ./vite.config.mjs --name portal",
    "dev:all": "node scripts/dev-all.mjs",
    "scaffold": "node scripts/scaffold-component.mjs",
    "dev:packages": "pnpm -r --if-present run dev",
    "test": "pnpm -r --if-present run test",
    "release": "node ./scripts/release.mjs",
    "release:dry": "node ./scripts/release.mjs --dry-run",
    "lint": "pnpm -r --if-present run lint",
    "format": "prettier --write '**/*.{js,mjs,css,md,json}'",
    "format:check": "prettier --check '**/*.{js,mjs,css,md,json}'"
  },
  "devDependencies": {
    "@pix-galaxy/pix-foundations": "workspace:*",
    "@pix-galaxy/pix-color-scheme-selector": "workspace:*",
    "@eslint/js": "9.24.0",
    "concurrently": "9.2.1",
    "eslint": "9.24.0",
    "prettier": "3.5.3",
    "typescript": "6.0.3",
    "vite": "8.0.10"
  },
  "engines": {
    "node": ">=20.11",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@11.9.0"
}
