{
  "name": "pix-galaxy",
  "private": true,
  "version": "0.1.0",
  "description": "Monorepo for the PixGalaxy ecosystem of zero-runtime-dependency vanilla JS Web Components",
  "type": "module",
  "author": "Emiliano Pisu",
  "license": "MIT",
  "homepage": "https://pixu1980.github.io/pix-galaxy/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pixu1980/pix-galaxy.git"
  },
  "bugs": {
    "url": "https://github.com/pixu1980/pix-galaxy/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/pixu1980"
  },
  "scripts": {
    "build": "pnpm build:lib && pnpm build:portal && pnpm -r --if-present run build",
    "build:lib": "pnpm -r --if-present run build:lib",
    "build:portal": "node scripts/fetch-downloads.mjs && vite build --config ./vite.config.mjs",
    "build:site": "pnpm build:lib && pnpm build:portal && pnpm -r --if-present run build:site",
    "build:types": "pnpm -r --if-present run build:types",
    "clean": "pnpm -r --if-present run clean",
    "dev": "pnpm build:lib && node scripts/dev.mjs --config ./vite.config.mjs --name portal",
    "dev:all": "pnpm build:lib && node scripts/dev-all.mjs",
    "scaffold": "node scripts/scaffold-component.mjs",
    "dev:packages": "pnpm build:lib && pnpm -r --if-present run dev",
    "test": "pnpm -r --if-present run test",
    "test:e2e": "playwright test",
    "release": "node ./scripts/release.mjs",
    "release:dry": "node ./scripts/release.mjs --dry-run",
    "lint": "pnpm -r --if-present run lint",
    "format": "prettier --write '**/*.{js,mjs,cjs,css,html,md,json,yml,yaml}'",
    "format:check": "prettier --check '**/*.{js,mjs,cjs,css,html,md,json,yml,yaml}'",
    "lint:format": "prettier --check '**/*.{js,mjs,cjs,css,html,md,json,yml,yaml}'",
    "typecheck": "pnpm -r --if-present run typecheck",
    "quality": "pnpm format:check && pnpm lint && pnpm typecheck",
    "test:portal": "node --test src/docs/catalog.test.mjs",
    "test:ssr": "node scripts/ssr-smoke.mjs",
    "test:coverage:portal": "c8 --reporter=text --check-coverage --lines=95 --functions=95 --branches=95 --statements=95 node --test src/docs/catalog.test.mjs"
  },
  "dependencies": {
    "@pix-galaxy/pix-a11y": "workspace:*",
    "@pix-galaxy/pix-color-scheme-selector": "workspace:*",
    "@pix-galaxy/pix-foundations": "workspace:*"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "commit-and-tag-version": "13.3.0",
    "concurrently": "10.0.6",
    "eslint": "10.10.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "@pix-galaxy/pix-accent-color-selector": "workspace:*",
    "c8": "12.0.0"
  }
}
